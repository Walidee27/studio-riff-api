                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('4 salles, room-4 en maintenance', () => {",
                  "  const rooms = pm.response.json();",
                  "  pm.expect(rooms).to.have.length(4);",
                  "  pm.expect(rooms[3].maintenance).to.eql({ start: '2026-11-05T00:00:00Z', end: '2026-11-08T00:00:00Z' });",
                  "});"
